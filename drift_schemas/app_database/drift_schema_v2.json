  "fixed_sql": [
    {
      "name": "places",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"places\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"latitude\" REAL NOT NULL, \"longitude\" REAL NOT NULL, \"radius_meters\" REAL NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "courses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"courses\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"active_from\" TEXT NULL, \"active_until\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "schedule_slots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"schedule_slots\" (\"id\" TEXT NOT NULL, \"course_id\" TEXT NOT NULL REFERENCES courses (id) ON DELETE CASCADE, \"place_id\" TEXT NOT NULL REFERENCES places (id) ON DELETE RESTRICT, \"weekday\" INTEGER NOT NULL, \"start_minute\" INTEGER NOT NULL, \"duration_minutes\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "location_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"location_events\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"place_id\" TEXT NULL, \"latitude\" REAL NULL, \"longitude\" REAL NULL, \"accuracy_meters\" REAL NULL, \"recorded_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "attendance_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attendance_records\" (\"id\" TEXT NOT NULL, \"slot_id\" TEXT NOT NULL, \"course_id\" TEXT NOT NULL, \"occurrence_date\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"check_in_at\" INTEGER NULL, \"evaluated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"slot_id\", \"occurrence_date\"));"
        }
      ]
    },
    {
      "name": "trips",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trips\" (\"id\" TEXT NOT NULL, \"from_place_id\" TEXT NOT NULL, \"to_place_id\" TEXT NOT NULL, \"departed_at\" INTEGER NOT NULL, \"arrived_at\" INTEGER NOT NULL, \"mode\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "user_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_settings\" (\"id\" INTEGER NOT NULL CHECK (id = 1), \"default_travel_mode\" TEXT NOT NULL, \"departure_buffer_minutes\" INTEGER NOT NULL, \"early_window_minutes\" INTEGER NOT NULL, \"grace_minutes\" INTEGER NOT NULL, \"late_until_minutes\" INTEGER NULL, \"max_accuracy_meters\" REAL NOT NULL, \"notifications_enabled\" INTEGER NOT NULL CHECK (\"notifications_enabled\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "class_sample_tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"class_sample_tasks\" (\"unique_name\" TEXT NOT NULL, \"slot_id\" TEXT NOT NULL, \"occurrence_date\" TEXT NOT NULL, \"offset_minutes\" INTEGER NOT NULL, \"class_start\" INTEGER NOT NULL, \"run_at\" INTEGER NOT NULL, PRIMARY KEY (\"unique_name\"));"
        }
      ]
    },
